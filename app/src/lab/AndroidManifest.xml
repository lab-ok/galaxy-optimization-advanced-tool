<?xml version="1.0" encoding="utf-8"?>
<!-- lab 빌드 전용: 앱별 화면 크기 시험에 필요할 수 있는 권한과 앱 목록 조회. 공개 빌드에는 합쳐지지 않는다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- adb shell pm grant 로 줄 수 있는 개발용 권한(signature|privileged|development) -->
    <uses-permission
        android:name="android.permission.CHANGE_CONFIGURATION"
        tools:ignore="ProtectedPermissions" />

    <!-- 최근 사용 순 정렬과 '방금 쓰던 앱' 찾기(사용 기록 접근, Shizuku로 허용) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application>
        <!-- 셸 도우미(DensityServer)가 셸 권한으로 바인더를 건네는 통로. 호출자 uid는 코드에서 다시 확인한다. -->
        <provider
            android:name="com.local.folddpifix.data.lab.ShellBridgeProvider"
            android:authorities="${applicationId}.shell"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <!-- 알림창 [작게]·[기본]·[크게]를 받아 방금 쓰던 앱의 크기를 바꾸는 투명 화면 -->
        <activity
            android:name="com.local.folddpifix.ui.lab.DensityStepActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
