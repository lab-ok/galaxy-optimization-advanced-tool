    <string name="rotate_calibrate_done_hint">이제 방금보다 조금 약하게 흔들어도 회전합니다.</string>
    <string name="rotate_calibrate_idle">기기를 움직이면 물방울도 움직입니다</string>
    <string name="rotate_calibrate_not_detected">흔들림을 인식하지 못했습니다</string>
