    <string name="toast_permission_reset">자동 적용을 끄고 적용 기록을 지웠습니다. PC에서 권한을 회수하세요</string>
    <string name="toast_permission_removed">권한이 회수되었습니다</string>
    <string name="toast_copied">복사했습니다</string>
