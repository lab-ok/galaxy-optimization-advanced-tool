<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 사용자 권한 창으로는 받을 수 없다. adb shell pm grant 로 1회 부여한다. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- 접기/펼치기 감시(선택 기능)용 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 흔들어서 화면 회전: 돌렸을 때 짧게 진동으로 알린다 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 앱 안 업데이트: GitHub 릴리스에서 새 버전을 확인하고 APK를 내려받는다(그 밖의 통신은 하지 않는다) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 앱 안 업데이트: Shizuku가 없을 때 시스템 설치 창으로 새 버전을 설치한다 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- WorkManager가 네트워크 조건용으로 넣는 권한. 네트워크 상태는 보지 않으므로 뺀다. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- 최근 사용 순 정렬과 '방금 쓰던 앱' 찾기(사용 기록 접근, Shizuku로 허용) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Shizuku 설치 여부 확인, 앱별 화면 크기에서 고를 앱 목록 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <!-- 기본 앱 정리: 목록 앱의 이름·아이콘을 읽으려고(Bloat.CATALOG와 같게 둔다) -->
        <package android:name="com.samsung.android.app.spage" />
        <package android:name="com.samsung.android.bixby.agent" />
        <package android:name="com.samsung.android.bixby.wakeup" />
        <package android:name="com.samsung.android.bixbyvision.framework" />
        <package android:name="com.samsung.android.visionintelligence" />
        <package android:name="com.samsung.android.game.gamehome" />
        <package android:name="com.samsung.android.game.gos" />
        <package android:name="com.samsung.android.arzone" />
        <package android:name="com.samsung.android.aremoji" />
        <package android:name="com.samsung.android.aremojieditor" />
        <package android:name="com.samsung.android.stickercenter" />
        <package android:name="com.samsung.android.app.tips" />
        <package android:name="com.samsung.android.voc" />
        <package android:name="com.samsung.android.service.peoplestripe" />
        <package android:name="com.samsung.android.dynamiclock" />
        <package android:name="com.samsung.android.kidsinstaller" />
        <package android:name="com.sec.android.app.kidshome" />
        <package android:name="com.samsung.android.da.daagent" />
        <package android:name="com.sec.android.easyMover" />
        <package android:name="com.samsung.android.app.watchmanagerstub" />
        <package android:name="com.sec.android.app.sbrowser" />
        <package android:name="com.samsung.android.email.provider" />
        <package android:name="com.samsung.android.spay" />
        <package android:name="com.samsung.android.scloud" />
        <package android:name="com.facebook.appmanager" />
        <package android:name="com.facebook.services" />
        <package android:name="com.facebook.system" />
        <package android:name="com.microsoft.skydrive" />
        <package android:name="com.linkedin.android" />
        <package android:name="com.netflix.partner.activation" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 메일 앱과 공유 대상(문제 신고를 메일 앱으로만 보내려고, 메일 앱이 아닌 공유 대상을 가려낸다) -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND_MULTIPLE" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- 홈 화면 앱(지금 앱 찾기에서 홈 화면을 빼려고) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Goat">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="density|screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".background.BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".background.ExternalChangeReceiver"
            android:exported="false" />

        <service
            android:name=".background.FoldWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Re-applies the user's display density when the foldable switches screens" />
        </service>
        <!-- Shizuku가 GOAT에 셸 권한 바인더를 건네는 통로(PC 없이 WRITE_SECURE_SETTINGS 받기) -->
        <!-- 앱 안 업데이트: 시스템 설치 결과(사용자 확인 필요·실패)를 받는다 -->
        <receiver
            android:name=".data.update.Updater$InstallResultReceiver"
            android:exported="false" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <!-- 셸 도우미(DensityServer)가 셸 권한으로 바인더를 건네는 통로. 호출자 uid는 코드에서 다시 확인한다. -->
        <provider
            android:name=".data.appsize.ShellBridgeProvider"
            android:authorities="${applicationId}.shell"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <!-- GOAT 상주 서비스 하나: 알림창 앱 화면 크기 조절과 흔들어서 화면 회전을 한 알림에 모은다 -->
        <service
            android:name=".background.GoatService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="One notification that adjusts the per-app display size of the front app and rotates the screen once when the user shakes the phone" />
        </service>
        <!-- 실험실 자동 플렉스의 시험 화면. 접고 펼 때 다시 만들어지지 않게 한다 -->
        <activity
            android:name=".ui.lab.FlexTestActivity"
            android:exported="false"
            android:configChanges="density|screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden" />
        <!-- 알림창 [작게]·[기본]·[크게]를 받아 방금 쓰던 앱의 크기를 바꾸는 투명 화면 -->
        <activity
            android:name=".ui.appsize.DensityStepActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
